{
  "expo": {
    "name": "Ponflix",
    "slug": "PonflixMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/ponflix-app-icon.png",
    "scheme": "ponflixmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ponflix.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#08090B",
        "foregroundImage": "./assets/branding/ponflix-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090B",
          "image": "./assets/branding/ponflix-logo.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb46a1fc-a088-442a-8290-0d4212e8327c"
      }
    }
  }
}
